# =============================================================================
# denso_backend — mẫu cấu hình. Copy thành .env rồi sửa giá trị thật:
#   cp .env.example .env
#
# TUYỆT ĐỐI không commit file .env (đã nằm trong .gitignore).
# =============================================================================

# --- Bảo mật ---------------------------------------------------------------
# Khoá Fernet mã hoá field (BẮT BUỘC, 44 ký tự base64). Sinh khoá mới bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Giá trị dưới đây CHỈ là mẫu — hãy thay bằng khoá của bạn.
FIELD_ENCRYPTION_KEY=O3d3VCzz6qrNXx1gk99BTkDg4TN6fjdK2E77AqAvmUE=

# Sinh SECRET_KEY thật (KHÔNG dùng giá trị django-insecure-* khi production):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-me-in-production
# DEBUG=False sẽ chặn khởi động nếu SECRET_KEY còn là giá trị django-insecure-*.
ALLOW_INSECURE_SECRET_KEY=false
DEBUG=True
# Danh sách host, phân tách bằng dấu phẩy.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + pgvector) --------------------------------------
# CHỈ DÙNG MỘT database cho cả dữ liệu nghiệp vụ (user, chat, raw_data) và
# vector. Lý do: `rag_rawdata.user_id` là khoá ngoại trỏ tới bảng `core_users`;
# PostgreSQL không hỗ trợ khoá ngoại xuyên database, nên tách 2 DB là không thể
# migrate được. Bảng `rag_chunkdata` (pgvector) nằm chung DB này.
#
# GIÁ TRỊ NÀY PHẢI KHỚP docker-compose.yml: database=denso, user=denso,
# password=denso. Nếu bạn dùng PostgreSQL riêng thì sửa cả hai cùng lúc.
#
# Cách 1 (khuyến nghị): URL đầy đủ.
DATABASE_URL=postgresql://denso:denso@localhost:5432/denso
# Cách 2: để trống DATABASE_URL và dùng các biến rời bên dưới.
# DB_NAME=denso
# DB_USER=denso
# DB_PASSWORD=denso
# DB_HOST=localhost
# DB_PORT=5432
# Thời gian giữ kết nối (giây). Tự động = 0 khi chạy test.
#
# ⚠️ Nếu DATABASE_URL trỏ tới connection POOLER của cloud Postgres
# (Neon/Supabase — hostname có chữ "-pooler"), nên để giá trị NHỎ (30–60).
# Pooler chủ động đóng kết nối rảnh; giữ lâu quá sẽ khiến Django lấy lại
# kết nối đã chết và trả 500 với lỗi
# "SSL error: unexpected eof while reading".
# Với PostgreSQL local (docker compose) thì 600 là bình thường.
DB_CONN_MAX_AGE=60
#
# LƯU Ý: llm_api và rag_worker phải trỏ tới ĐÚNG database này (biến
# DATABASE_URL trong .env của từng service). Cả 3 service dùng chung một DB.

# --- Microservice ----------------------------------------------------------
# llm_api (FastAPI): RAG + gọi model.
LLM_API_BASE_URL=http://localhost:8100
LLM_API_TIMEOUT=120
LLM_API_STREAM_TIMEOUT=600
# Phải BẰNG `INTERNAL_API_TOKEN` trong llm_api/.env.
# Sinh: python -c "import secrets; print(secrets.token_urlsafe(32))"
LLM_API_TOKEN=

# rag_worker (FastAPI/Celery): nạp tài liệu vào vector DB.
RAG_WORKER_URL=http://localhost:8200
# http  = gọi thẳng API của rag_worker (không cần Redis) — mặc định.
# celery = đẩy task qua broker (cần Redis đang chạy).
RAG_INGEST_MODE=http
RAG_INGEST_TIMEOUT=600
# Phải BẰNG `INTERNAL_API_TOKEN` trong rag_worker/.env.
RAG_WORKER_TOKEN=

# Số chiều vector — phải khớp EMBEDDING_DIM của llm_api/rag_worker
# và cột `vector` của bảng rag_chunkdata (đổi thì phải tạo migration).
RAG_EMBEDDING_DIM=768

# Số message lịch sử tối đa gửi sang llm_api mỗi lượt hỏi (llm_api còn có trần
# cứng riêng và sẽ trả 422 nếu vượt).
LLM_MAX_HISTORY_MESSAGES=100

# --- Xác thực / JWT --------------------------------------------------------
# false = refresh token trả trong JSON body (dễ dùng cho desktop/mobile/Postman).
# true  = refresh token nằm trong cookie HttpOnly (an toàn hơn cho web).
JWT_ALLAUTH_REFRESH_TOKEN_AS_COOKIE=false

# --- CORS ------------------------------------------------------------------
# Danh sách origin frontend được phép gọi API (phân tách bằng dấu phẩy).
# Để trống = chặn mọi cross-origin request (mặc định an toàn).
CORS_ALLOWED_ORIGINS=
# true = cho phép mọi origin. CHỈ dùng cho demo nhanh, KHÔNG dùng production.
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=true

# --- Chống spam / brute-force ----------------------------------------------
# 429 khi vượt. Tắt trong test (`manage.py test`) để không ảnh hưởng test.
THROTTLE_ANON=60/min
THROTTLE_USER=600/min

# --- Celery (chỉ cần khi RAG_INGEST_MODE=celery) ---------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# --- Tuỳ chọn --------------------------------------------------------------
API_PAGE_SIZE=20
LOG_LEVEL=INFO
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
